{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-multi-msvc",
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "displayName": "Ninja Multi-Config (MSVC)",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "ninja-multi-mingw",
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "displayName": "Ninja Multi-Config (MinGW)",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc.exe",
        "CMAKE_CXX_COMPILER": "g++.exe"
      }
    },
    {
      "name": "ninja-multi-gcc",
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "displayName": "Ninja Multi-Config (GCC)",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ninja-multi-clang",
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "displayName": "Ninja Multi-Config (Clang)",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-debug-msvc",
      "configurePreset": "ninja-multi-msvc",
      "displayName": "Build (MSVC-Debug)",
      "description": "Build with Ninja (MSVC-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "ninja-release-msvc",
      "configurePreset": "ninja-multi-msvc",
      "displayName": "Build (MSVC-Release)",
      "description": "Build with Ninja (MSVC-Release)",
      "configuration": "Release"
    },
    {
      "name": "ninja-debug-mingw",
      "configurePreset": "ninja-multi-mingw",
      "displayName": "Build (MinGW-Debug)",
      "description": "Build with Ninja (MinGW-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "ninja-release-mingw",
      "configurePreset": "ninja-multi-mingw",
      "displayName": "Build (MinGW-Release)",
      "description": "Build with Ninja (MinGW-Release)",
      "configuration": "Release"
    },
    {
      "name": "ninja-debug-gcc",
      "configurePreset": "ninja-multi-gcc",
      "displayName": "Build (GCC-Debug)",
      "description": "Build with Ninja (GCC-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "ninja-release-gcc",
      "configurePreset": "ninja-multi-gcc",
      "displayName": "Build (GCC-Release)",
      "description": "Build with Ninja (GCC-Release)",
      "configuration": "Release"
    },
    {
      "name": "ninja-debug-clang",
      "configurePreset": "ninja-multi-clang",
      "displayName": "Build (Clang-Debug)",
      "description": "Build with Ninja (Clang-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "ninja-release-clang",
      "configurePreset": "ninja-multi-clang",
      "displayName": "Build (Clang-Release)",
      "description": "Build with Ninja (Clang-Release)",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test-msvc-debug",
      "configurePreset": "ninja-multi-msvc",
      "displayName": "Test (MSVC-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "test-msvc-release",
      "configurePreset": "ninja-multi-msvc",
      "displayName": "Test (MSVC-Release)",
      "configuration": "Release"
    },
    {
      "name": "test-mingw-debug",
      "configurePreset": "ninja-multi-mingw",
      "displayName": "Test (MinGW-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "test-mingw-release",
      "configurePreset": "ninja-multi-mingw",
      "displayName": "Test (MinGW-Release)",
      "configuration": "Release"
    },
    {
      "name": "test-gcc-debug",
      "configurePreset": "ninja-multi-gcc",
      "displayName": "Test (GCC-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "test-gcc-release",
      "configurePreset": "ninja-multi-gcc",
      "displayName": "Test (GCC-Release)",
      "configuration": "Release"
    },
    {
      "name": "test-clang-debug",
      "configurePreset": "ninja-multi-clang",
      "displayName": "Test (Clang-Debug)",
      "configuration": "Debug"
    },
    {
      "name": "test-clang-release",
      "configurePreset": "ninja-multi-clang",
      "displayName": "Test (Clang-Release)",
      "configuration": "Release"
    }
  ]
}