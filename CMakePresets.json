{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-multi-msvc",
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "displayName": "Ninja Multi-Config (MSVC)",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "ninja-multi-msvc-x64",
      "inherits": "ninja-multi-msvc",
      "displayName": "Ninja Multi-Config (MSVC x64)",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "ninja-multi-msvc-x86",
      "inherits": "ninja-multi-msvc",
      "displayName": "Ninja Multi-Config (MSVC x86)",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "ninja-multi-msvc-arm64",
